# Copy this file to .env.local and fill in your real WhatsApp number
# (international format, digits only, no + or leading 0), e.g. 94771234567.
NEXT_PUBLIC_TEST_FORM_WHATSAPP_NUMBER=94771234567

# --- Admin login (required) ---
# The very first time the app runs with no accounts yet, it creates one
# admin account from these two values. Set them before your first
# deploy/run; after the admin account exists, these are no longer read.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-something-long-and-random

# --- Session signing key (recommended) ---
# Signs the login cookie. If left unset, a random one is generated each
# time the server starts, which logs everyone out on every restart/redeploy
# — set this to any long random string so logins persist normally.
SESSION_SECRET=change-this-to-a-long-random-string
